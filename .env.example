APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: use MySQL to match production (sessions, cache, queues default to database — all in one dump).
# 1) Install MySQL 8+ and create a database, e.g. CREATE DATABASE mmhc_crm CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 2) Copy this file to .env, set DB_* below, then: php artisan key:generate && php artisan migrate
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mmhc_crm
DB_USERNAME=root
DB_PASSWORD=

# Optional: SQLite for quick experiments only (phpunit uses sqlite :memory: via phpunit.xml)
# DB_CONNECTION=sqlite
# # DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SERVE_STORAGE_VIA_LARAVEL=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AiSensy / Sensy WhatsApp OTP (Login with Phone)
# 1. Get API key from AiSensy dashboard (Manage > API Key)
# 2. Create an API campaign using your OTP template; set campaign name here
# 3. API URL: set SENSY_API_URL (host) or AISENSY_BASE_URL (full endpoint) if different from default
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=otp_login
# Template must use a single variable {{1}} = OTP (matches AiSensy auth template + optional Copy code)
# API host (default path /campaign/t1/api/v2 is appended)
SENSY_API_URL=https://backend.aisensy.com
# Optional: full endpoint URL override (if set, SENSY_API_URL is ignored)
# AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# Subscription payment settings
SUBSCRIPTION_GST_RATE=18
SUBSCRIPTION_UPI_ID=
SUBSCRIPTION_UPI_MERCHANT_NAME=MMHC

# Payment gateway settings
PAYMENT_PROVIDER=manual
PAYMENT_MODE=test

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

SUBSCRIPTION_MANUAL_PAYMENT_ENABLED=false
STAFF_PAYOUT_MANUAL_ENABLED=true

RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1
RAZORPAYX_VERIFY_SSL=true

# Full site backup (optional paths if mysqldump/mysql are not on PATH)
# BACKUP_RELATIVE_PATH=site-backups
# BACKUP_MYSQLDUMP_PATH=
# BACKUP_MYSQL_PATH=
# BACKUP_KEEP_DAYS=14
