# Production checklist (override in server .env — do not copy APP_DEBUG=true to production):
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# LOG_LEVEL=warning

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: use MySQL to match production (sessions, cache, queues default to database — all in one dump).
# 1) Install MySQL 8+ and create a database, e.g. CREATE DATABASE mmhc_crm CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 2) Copy this file to .env, set DB_* below, then: php artisan key:generate && php artisan migrate
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mmhc_crm
DB_USERNAME=root
DB_PASSWORD=

# Tests: phpunit uses MySQL; tests/bootstrap.php auto-creates DB_DATABASE (default mmhc_crm_test) if your MySQL user can CREATE DATABASE.
# Optional: SQLite for local experiments only (not used by PHPUnit):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS + Capacitor WebView): set APP_URL=https://themmhc.com and typically:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SERVE_STORAGE_VIA_LARAVEL=true
QUEUE_CONNECTION=database

# --- Cache: local vs production (WhatsApp OTP login uses cache; pick what matches your machine) ---
# LOCAL Windows (no PHP "redis" extension / no Redis server): use database or file — NOT redis.
#   CACHE_STORE=database   ← matches this file; works with MySQL you already use for SESSION.
#   CACHE_STORE=file       ← also fine; stores under storage/framework/cache
# PRODUCTION / server with Redis installed + phpredis OR predis: redis is ideal for OTP TTL + rate limits.
#   CACHE_STORE=redis
# If you use redis: install Redis server, set REDIS_CLIENT=phpredis (needs ext-redis) OR predis + REDIS_CLIENT=predis
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pal Digital WhatsApp — single OTP channel for login, profile, rewards, referrals, service completion
# Meta template: mmhc_verification_code2 (Copy code, Authentication)
# After Meta approves: Pal → Templates → Sync from Meta → Create API campaign → paste campaign UUID below
PAL_DIGITAL_INTEGRATION_KEY=
PAL_DIGITAL_CAMPAIGN_ID=
PAL_DIGITAL_BASE_URL=https://wa.paldigital.in
# PAL_DIGITAL_DEFAULT_CONTACT_NAME=MMHC User
# PAL_DIGITAL_CA_BUNDLE=C:\path\to\cacert.pem
# PAL_DIGITAL_HTTP_VERIFY=true

# Login OTP TTL (seconds); stored in the default cache store (see CACHE_STORE above).
PHONE_LOGIN_OTP_TTL_SECONDS=600
# Profile “bind new phone” OTP TTL (seconds); Redis key phone_bind_otp:v1:{userId}:{e164}
PHONE_BIND_OTP_TTL_SECONDS=300
# Optional dedicated secret for OTP HMAC; defaults to APP_KEY
# OTP_PEPPER=

# Subscription payment settings
SUBSCRIPTION_GST_RATE=18
SUBSCRIPTION_UPI_ID=
SUBSCRIPTION_UPI_MERCHANT_NAME=MMHC

# Payment gateway settings
PAYMENT_PROVIDER=manual
PAYMENT_MODE=test

# --- Subscriptions (patients + students): Razorpay Checkout ---
# Razorpay Dashboard → Account & Settings → API keys (Live): Key ID + Key Secret (secret shown once; Regenerate if lost)
# Webhooks tab: URL https://your-domain.com/webhooks/razorpay — event payment.captured — copy signing secret below
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# Manual UPI + screenshot for healthcare plans (usually false when Razorpay is on)
SUBSCRIPTION_MANUAL_PAYMENT_ENABLED=false
SUBSCRIPTION_MANUAL_WITH_RAZORPAY=false

# Student ₹1,200 membership — Razorpay when enabled (recommended)
# Manual UPI only used when RAZORPAY_ENABLED=false (local/dev fallback)
STUDENT_SUBSCRIPTION_ENABLED=true
STUDENT_SUBSCRIPTION_PLAN_SLUG=student-journey-launch
STUDENT_SUBSCRIPTION_MANUAL_PAYMENT=false
STUDENT_SUBSCRIPTION_MANUAL_WITH_RAZORPAY=false
STUDENT_SUBSCRIPTION_AUTO_ACTIVATE_MANUAL=false

# --- Staff payouts (nurse/caregiver): manual only — NOT Razorpay / RazorpayX ---
STAFF_PAYOUT_MANUAL_ENABLED=true
STAFF_PAYOUT_RAZORPAYX_ALLOWED=false

RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1
RAZORPAYX_VERIFY_SSL=true

# --- PWA Web Push (browser notifications — no Play Store / Capacitor) ---
# One command on local AND server (after composer install):
#   php artisan webpush:setup
#   php artisan config:clear
#   php artisan migrate
WEBPUSH_ENABLED=true
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Full site backup (optional paths if mysqldump/mysql are not on PATH)
# BACKUP_RELATIVE_PATH=site-backups
# BACKUP_MYSQLDUMP_PATH=
# BACKUP_MYSQL_PATH=
# BACKUP_KEEP_DAYS=14
