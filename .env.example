APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: use MySQL to match production (sessions, cache, queues default to database — all in one dump).
# 1) Install MySQL 8+ and create a database, e.g. CREATE DATABASE mmhc_crm CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 2) Copy this file to .env, set DB_* below, then: php artisan key:generate && php artisan migrate
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mmhc_crm
DB_USERNAME=root
DB_PASSWORD=

# Tests: phpunit uses MySQL; tests/bootstrap.php auto-creates DB_DATABASE (default mmhc_crm_test) if your MySQL user can CREATE DATABASE.
# Optional: SQLite for local experiments only (not used by PHPUnit):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS + Capacitor WebView): set APP_URL=https://themmhc.com and typically:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SERVE_STORAGE_VIA_LARAVEL=true
QUEUE_CONNECTION=database

# --- Cache: local vs production (SMS OTP login uses cache; pick what matches your machine) ---
# LOCAL Windows (no PHP "redis" extension / no Redis server): use database or file — NOT redis.
#   CACHE_STORE=database   ← matches this file; works with MySQL you already use for SESSION.
#   CACHE_STORE=file       ← also fine; stores under storage/framework/cache
# PRODUCTION / server with Redis installed + phpredis OR predis: redis is ideal for OTP TTL + rate limits.
#   CACHE_STORE=redis
# If you use redis: install Redis server, set REDIS_CLIENT=phpredis (needs ext-redis) OR predis + REDIS_CLIENT=predis
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sent.dm — SMS OTP (phone login + domain OTPs: referrals, patient rewards, service completion, profile phone)
# https://docs.sent.dm/ — create an SMS template; set SENT_DM_OTP_PARAMETER_NAME to the exact placeholder key (e.g. code, otp).
SENT_DM_API_KEY=
SENT_DM_TEMPLATE_ID=
SENT_DM_OTP_PARAMETER_NAME=code
# SENT_DM_SANDBOX=true
# SENT_DM_BASE_URL=https://api.sent.dm/v3/messages
# Windows PHP cURL error 60 (SSL): download https://curl.se/ca/cacert.pem and set absolute path:
# SENT_DM_CA_BUNDLE=C:\path\to\cacert.pem
# Or local-only workaround (never on production): SENT_DM_HTTP_VERIFY=false
# Login OTP TTL (seconds); stored in the default cache store (see CACHE_STORE above).
PHONE_LOGIN_OTP_TTL_SECONDS=600
# Profile “bind new phone” OTP TTL (seconds); Redis key phone_bind_otp:v1:{userId}:{e164}
PHONE_BIND_OTP_TTL_SECONDS=300
# Optional dedicated secret for OTP HMAC; defaults to APP_KEY
# OTP_PEPPER=

# Subscription payment settings
SUBSCRIPTION_GST_RATE=18
SUBSCRIPTION_UPI_ID=
SUBSCRIPTION_UPI_MERCHANT_NAME=MMHC

# Payment gateway settings
PAYMENT_PROVIDER=manual
PAYMENT_MODE=test

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

SUBSCRIPTION_MANUAL_PAYMENT_ENABLED=false

# Student ₹1,200 membership — UPI + screenshot when Razorpay is off (default: enabled)
STUDENT_SUBSCRIPTION_MANUAL_PAYMENT=true
STUDENT_SUBSCRIPTION_AUTO_ACTIVATE_MANUAL=true
STAFF_PAYOUT_MANUAL_ENABLED=true

RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_BASE_URL=https://api.razorpay.com/v1
RAZORPAYX_VERIFY_SSL=true

# Full site backup (optional paths if mysqldump/mysql are not on PATH)
# BACKUP_RELATIVE_PATH=site-backups
# BACKUP_MYSQLDUMP_PATH=
# BACKUP_MYSQL_PATH=
# BACKUP_KEEP_DAYS=14
